# =============================================================================
# Reddix Robotics Frontend — Environment Variables
# =============================================================================
# Copy this file to `.env.local` and fill in the values.
# NEVER commit `.env.local` or any file containing real secrets.
#
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# =============================================================================

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
# Base URL for the NestJS backend REST API (no trailing slash).
# Example: http://localhost:3000/api
VITE_API_BASE_URL=http://localhost:3000/api

# API request timeout in milliseconds (default: 15000)
VITE_API_TIMEOUT=15000

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Human-readable app name used in meta tags and headings
VITE_APP_NAME=Reddix Robotics

# App version (semver) – usually injected by CI
VITE_APP_VERSION=0.1.0

# ---------------------------------------------------------------------------
# Feature Flags (set to "true" / "false")
# ---------------------------------------------------------------------------
# Enable the 3D scene on the hero section
VITE_FEATURE_3D_HERO=true

# Enable contact form API submission
VITE_FEATURE_CONTACT_FORM=false
